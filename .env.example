# ─────────────────────────────────────────────────────────────────────────────
# Travel Planner Agent – Environment Variables
# Copy this to .env and fill in your IBM Cloud credentials.
# All other APIs work without keys — real live data out of the box!
# ─────────────────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=your-secure-secret-key-here
FLASK_ENV=development
DEBUG=True
PORT=5000

# ── IBM watsonx.ai (IBM Cloud) ────────────────────────────────────────────────
# Required — get from: IBM Cloud → Manage → Access (IAM) → API Keys
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=your_project_id_here

# IBM Granite Model
GRANITE_CHAT_MODEL=ibm/granite-4-h-small
GRANITE_INSTRUCT_MODEL=ibm/granite-4-h-small

# ── Live Data APIs (NO KEY REQUIRED — works out of the box) ──────────────────
# Weather:      wttr.in          — free, no key, real-time
# Currency:     frankfurter.app  — ECB official rates, free, no key
# Country facts: built-in curated database — no key
# Destination:  Wikipedia REST + Nominatim (OpenStreetMap) + REST Countries — free, no key

# ── Optional: OpenWeatherMap (higher quota / reliability) ─────────────────────
# Sign up free at: https://openweathermap.org/api → API Keys tab
# If set, this REPLACES wttr.in for weather data
OPENWEATHER_API_KEY=

# ── Optional: Amadeus Travel API (live real flight & hotel prices) ────────────
# Sign up free sandbox at: https://developers.amadeus.com
# Create an app → copy API Key + Secret
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_SANDBOX=True

# ── Optional: OpenTripMap (live tourist attractions) ──────────────────────────
# Sign up free at: https://dev.opentripmap.org
OPENTRIPMAP_API_KEY=

# ── Langflow Orchestration (Optional) ────────────────────────────────────────
# Langflow adds a visual flow builder on top of the chat pipeline.
# The chat endpoint tries Langflow first; if unavailable it falls back to IBM Granite.
#
# Step 1 – Install Langflow locally:
#   pip install langflow
#   langflow run            # starts on http://127.0.0.1:7860
#   (or use Docker — see README)
#
# Step 2 – Create a flow in the Langflow UI and copy the flow UUID from the URL:
#   http://127.0.0.1:7860/flow/<FLOW_ID>
#
# Step 3 – Fill in the values below:
LANGFLOW_HOST=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=30

# ── LLM Parameters ────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_TOP_K=50

# ── App Settings ──────────────────────────────────────────────────────────────
MAX_ITINERARY_DAYS=30
DEFAULT_CURRENCY=USD
SESSION_LIFETIME=3600
